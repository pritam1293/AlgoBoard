# Environment Variables Template for AlgoBoard
# Copy this file to .env and update with your actual values

# Neon PostgreSQL Configuration
# Use the JDBC connection string from Neon, e.g.
# jdbc:postgresql://ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=jdbc:postgresql://your-neon-host/neondb?sslmode=require
DATABASE_USERNAME=your_neon_username
DATABASE_PASSWORD=your_neon_password
DB_POOL_SIZE=5

# Local development: after the initial migration, uncomment these to defer
# database work and skip Flyway/Hibernate schema checks on startup.
# Re-enable (delete or set defaults) when adding new migrations.
# FLYWAY_ENABLED=false
# JPA_DDL_AUTO=none
# DB_MIN_IDLE=0
# DB_INIT_FAIL_TIMEOUT=-1
# HIBERNATE_JDBC_METADATA_ACCESS=false
# JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Cache Configuration
# simple = in-memory cache (no Redis required); redis = use Redis
CACHE_TYPE=simple

# Redis settings (only used when CACHE_TYPE=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT Configuration (secret must be Base64 and decode to at least 32 bytes)
# Generate one with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
JWT_EXPIRATION=86400000

# Optional LeetCode past-contest history account (leave empty to disable)
LEETCODE_PAST_CONTESTS_USERNAME=
